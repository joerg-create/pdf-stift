{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF Stift",
  "version": "1.0.0",
  "identifier": "de.pdfstift.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PDF Stift",
        "width": 1200,
        "height": 900,
        "minWidth": 380,
        "minHeight": 500,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "PDF öffnen, zeichnen, Linien begradigen, Text einfügen",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "languages": ["German"],
        "installMode": "currentUser"
      }
    }
  }
}
