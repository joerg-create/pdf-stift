{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Öffnen- und Speichern-Dialog, PDFs lesen und schreiben",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
